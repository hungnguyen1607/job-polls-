[Unit]
Description=Internship watcher (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/ats-scrapers
ExecStart=%h/ats-scrapers/.venv/bin/python scripts/watch_%i.py
# SIGINT lets run_group finish cleanly (it writes the CSVs on KeyboardInterrupt).
KillSignal=SIGINT
TimeoutStopSec=30
Restart=always
RestartSec=30
StandardOutput=append:%h/ats-scrapers/engineering-ats/%i.out
StandardError=append:%h/ats-scrapers/engineering-ats/%i.out
Nice=5
# All watchers share one cgroup budget (internship.slice) so the server's other apps keep their RAM.
Slice=internship.slice
# MAX_CHILDREN etc. (written by setup_server.sh, sized to the box).
EnvironmentFile=-%h/ats-scrapers/.env.server

[Install]
WantedBy=default.target
